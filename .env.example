# ===========================================================================
# 本文件只放示例值，不含真实密钥，可安全提交。
# 使用方式：复制本文件为 .env，再把自己的真实密钥/密码填进 .env。
# ===========================================================================

# --- 运行模式 ------------------------------------------------------------
# real（缺省）：真实的 LangGraph 问数、Deep Agents 经营分析、LLM、Embedding、
#               精排和 RAG 检索。需要下面的 API Key。
# demo        ：以上全部换成确定性替身，**一把 Key 都不需要**，
#               结果可重复，且前端与回答都会明确标注是 Demo。
#               只支持固定的几个演示问题，其它问题返回结构化提示。
#
# 不填这一段就是 real —— 老环境行为完全不变。
# 填了非法值（比如 APP_MODE=dmeo）后端会**启动失败**并指出合法取值，
# 不会静默退回 real。
APP_MODE=real

# --- 模型配置：填任意 OpenAI 兼容服务即可 --------------------------------

# 密钥一律**留空**，不要写占位符。
#
# 为什么不留 `sk-xxxxxxxx` 这类示例值：它是非空字符串，程序无法区分
# 「这是占位符」和「这是真 Key」，于是会真的拿它去调接口，
# 结果是一个鉴权失败——而用户按 README 复制本文件后本该能直接跑起来。
# 留空则各处都走「未配置」分支：demo 模式下一切正常，real 模式下
# 报错明确指向缺哪个变量。
#
# 格式参考（填你自己的）：
#   DeepSeek   sk-...        OPENAI_BASE_URL=https://api.deepseek.com/v1
#   通义千问   sk-...        OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat

# --- 本地 PostgreSQL（由 docker-compose.yml 启动） ------------------------
# 这三个变量会被 docker-compose.yml 读取，用来初始化数据库。
# 注意：只在数据库 volume 首次创建时生效。改了密码要重新初始化才有效
# （docker compose down -v 之后再 up，会清空已有数据）。
# 密码里如果含 $ 符号，在 .env 中要写成 $$，否则会被 Compose 当成变量插值。

POSTGRES_DB=data_platform
POSTGRES_USER=data_platform
POSTGRES_PASSWORD=data_platform_dev

# 后端连接串。驱动部分必须是 postgresql+asyncpg，不能只写 postgresql：
# 后端用的是异步 SQLAlchemy，只装了 asyncpg，写成 postgresql:// 会去找未安装的 psycopg2。
# 主机名用 localhost —— 后端跑在宿主机，不是容器里。
# 以后后端也放进 Compose 时，主机名要改成服务名 postgres。
DATABASE_URL=postgresql+asyncpg://data_platform:data_platform_dev@localhost:5432/data_platform
# 仅用于 compose 容器内的独立演示数据库；不要覆盖 DATABASE_URL。
DATABASE_URL_DEMO=postgresql+asyncpg://data_platform:data_platform_dev@localhost:5432/data_platform_demo

# 仅 Docker Compose 内的后端使用；容器内不能用 localhost。
DATABASE_URL_DOCKER=postgresql+asyncpg://data_platform:data_platform_dev@postgres:5432/data_platform



# --- RAG embedding 配置（阿里云百炼 / DashScope OpenAI 兼容模式）----------
# 与上面的 OPENAI_* 分开配置：对话模型和 embedding 模型是两次独立的服务调用，
# 用不同的 Key 和不同的模型名，混在一起改一处会连带影响另一处。
#
# EMBEDDING_DIMENSION 必须与 EMBEDDING_MODEL 实际输出维度一致，
# 也要与后续 pgvector 建表时的 vector(N) 一致。text-embedding-v4 支持
# 1024 维（另有 2048/1536/768/512/256 等档位，改这里要同步改建表的 N）。
# 用 Azure/OpenAI 时把 BASE_URL 换成 https://api.openai.com/v1，MODEL 换成
# text-embedding-3-small（1536 维）即可，代码不用动。
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
# 同上：留空表示「未配置」。不配它时知识库导入会被跳过（INIT_KNOWLEDGE_MODE=auto），
# 基础数据库与零售数据照常初始化。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1


# --- RAG 检索增强：查询改写 ------------------------------------------------
# 检索前先用模型把用户问题换成几种更贴近文档表达的说法，提高召回。
# 改写只影响「检索什么」，最终回答始终针对用户的原问题。
# 模型失败、超时或被限流时会自动降级成「只用原问题检索」，不影响问答可用性。
# 关掉它就不会为改写多付一次模型调用。

# 是否在知识检索前使用模型生成通用搜索表达
RAG_QUERY_REWRITE_ENABLED=true

# 最多生成多少条改写问题；合法范围为 0~2
RAG_MAX_REWRITTEN_QUERIES=2


# --- RAG 检索增强：精排（rerank）-------------------------------------------
# 先按向量 + 关键词召回一批候选（默认 20 条），再用一个专门的重排模型
# 逐条判断「这段文字到底答不答这个问题」，最后只留最相关的几条。
#
# 精排只是一个增益步骤：超时、限流、5xx 或响应格式不对时，
# 会自动退回召回阶段的 RRF 顺序，问答照常可用。
# 关掉它（RAG_RERANK_ENABLED=false）就不需要下面那几个 RERANK_* 配置。

# 是否在召回之后做精排
RAG_RERANK_ENABLED=true

# 精排最多接收多少条候选；合法范围 1~20
RAG_RETRIEVAL_CANDIDATE_LIMIT=20

# 精排之后最终留下几条交给回答模型；必须不超过上面的候选上限
RAG_FINAL_TOP_K=5

# 精排服务商。目前只支持 dashscope（阿里云百炼）
RERANK_PROVIDER=dashscope

# 精排模型。qwen3-rerank 单条文档上限 4,000 token，单次最多 500 条文档；
# 注意它的响应里 results 在**顶层**，与 gte-rerank-v2 的 output.results 不同。
RERANK_MODEL=qwen3-rerank

# 百炼的 API Key。留空表示未配置（精排会被跳过，问答退回 RRF 顺序）。
RERANK_API_KEY=

# 百炼的业务空间地址。**留空**时精排不可用；要用就换成自己的空间 ID。
# 注意：这里**不要**带 /reranks 结尾——完整地址由代码自己拼上这一段。
RERANK_BASE_URL=

# 单次精排请求的超时秒数，必须为正数
RERANK_TIMEOUT_SECONDS=10
